class Solution:
    def lengthOfLongestSubstring(self, s: str) -> int:
        n = len(s)
        ml = 0
        for i in range(n):
            hsh = [0] * 256
            for j in range(i, n):
                if hsh[ord(s[j])]:
                    break
                else:
                    hsh[ord(s[j])] = 1
                    ml = max(ml, j - i + 1)
        return ml
