https://leetcode.com/problems/words-within-two-edits-of-dictionary/

class Solution:
    def twoEditWords(self, queries: List[str], dictionary: List[str]) -> List[str]:
        l=len(queries[0])
        res=[]
        for q in queries:
            for d in dictionary:
                c=0
                for j in range(l):
                    if(q[j]!=d[j]):
                        c+=1
                        if c>2:
                            break 
                if c<=2:
                    res.append(q)
                    break 
        return res
