Q:Given an array of unique elements, construct a Binary Search Tree and find the height of the tree.

# Enter your code here. Read input from STDIN. Print output to STDOUTt
class Node:
    def __init__(self,data):
        self.data=data
        self.left=None
        self.right=None
def insert(root,data):
    if root is None:
        return Node(data)
    if data<root.data:
        root.left=insert(root.left,data)
    else:
        root.right=insert(root.right,data)
    return root
def height(root):
    if root is None:
        return -1
    return max(height(root.left),height(root.right))+1 
def build(l):
    root=None
    for j in l:
        root=insert(root,j)
    return root
t=int(input())
for _ in range(t):
    n=int(input())
    l=list(map(int,input().split()))
    root=build(l)
    print(height(root))
